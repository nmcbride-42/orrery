# Orrery needs no secrets and no service configuration.
# The only environment variables it touches are PyTorch allocator hints, which
# orrery/train.py sets by default (setdefault) when they are not already set.
# Override them here if your setup needs something different.

# CUDA builds of PyTorch: keep the caching allocator compact under variable edge counts
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# ROCm builds of PyTorch (ignored by some ROCm versions)
PYTORCH_HIP_ALLOC_CONF=expandable_segments:True
